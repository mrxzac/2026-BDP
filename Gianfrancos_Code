'''
Finds the max bending moments across the bridge
'''
max_moments = []
def find_max_moments():
    global Forces
    global leForces
    global leDistances
    the_max = 0
    for i in range(344):
        Define_bridge(i, P)
        max_moments.append(Highest_moment(i,P))

    for i in range(len(max_moments)):
        if max_moments[i] > the_max:
            the_max = max_moments[i]
    return the_max
