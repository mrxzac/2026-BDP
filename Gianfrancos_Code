import math
pi = math.pi

def Calc_flex_yield_tens(MaxM,I,Ytens):
    #  Max moment is the coeffcient that is in the BMD in mm
    #  I in mm^4
    #  Y is from centroidal axis to side that is in tension, in mm
    #  Uses Yield stress tension of matboard (30Mpa)
    #  Final result will be in newtons
    #  If the total weight in all three carts exceeds this value, the bridge will fail in flexural tension
   # print(f"{MaxM}, {I}, {Ytens}")
    stress = (MaxM*Ytens)/I
    Fos = 30/stress
    return Fos

def Calc_flex_yield_comp(MaxM,I,Ycomp):
    #  Max moment is the coeffcient that is in the BMD in mm
    #  I in mm^4
    #  Y is from centroidal axis to side that is in compression, in mm
    #  Uses Yield stress tension of matboard (6Mpa)
    #  Final result will be in newtons
    #  If the total weight in all three carts exceeds this value, the bridge will fail in flexural compression
    stress =  (MaxM*Ycomp)/I
    Fos = 6/stress
    return Fos

def Calc_shear_stress_fail(MaxV,I,Bintrest, Qintrest, matType):
    #  Max shear force is the coeffcient that is in the SFD, is unitless
    #  I in mm^
    #  Bintrest is the width at the depth of intrest, in mm
    #  Qintrest is the Q at the depth of intrest. Can be above or below the cut, as the magnitude will be equal regardless
    #  matType should be 'glue' or 'matboard', as each one will have a different shear stress
    if matType == 'glue':
        stress = 2
    elif matType == 'matboard':
        stress = 4
    stress_shear = (MaxV*Qintrest)/(I*Bintrest)
   # print(f'Shear stress {stress_shear}')
    Fos =  stress/stress_shear
    return Fos

