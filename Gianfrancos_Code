def Define_bridge(Xini,P):
    global Forces
    global leForces
    global leDistances
    global Ay
    global By
   # Xini = 172
    # Is weight of total train
   # P = P#TBD
    Forces = {Xini:0.1666666*P,Xini+176:0.1666666*P,Xini+340:0.1666666*P,Xini+516:0.1666666*P, Xini+680:0.1666666*P, Xini+856:0.1666666*P}
    Total_moment = 0
    leForces = list(Forces.keys())
    leDistances = list(Forces.values())
    # Sums total moment of forces
    for i in range(len(Forces)):
        Total_moment += (leForces[i]*Forces[leForces[i]])

    By = -1*Total_moment/1200
    Ay = -P-By
    Reaction_forces = [Ay,By]

Define_bridge(172,P)

'''
Creates equivalent to shear force diagram
'''
def find_shear(mm):
    global Forces
    global leForces
    global leDistances
    global Ay
    Shear  =  Ay
    i = 0
    if mm>leForces[-1]:
        return  Ay + sum(leDistances)
    while mm>leForces[i]:
        Shear += Forces[leForces[i]]
        i += 1
    return Shear

print(find_shear(900))

'''Creates equivalent to Bending moment diagram '''
def find_moment(mm):
    global Forces
    global leForces
    global leDistances
    dist_below = []
    Moment = 0
    for i in range(len(leForces)):
        if leForces[i]<mm:
            dist_below.append(leForces[i])
    if mm>leForces[0]:
        Moment += find_shear(Forces[leForces[0]])*leForces[0]
    elif mm<=leForces[0]:
        return find_shear(leForces[0])*mm
    for i in range(1,len(dist_below)):
       # print(find_shear(dist_below[i]-1))
        Moment += find_shear(dist_below[i]-1)*(dist_below[i]-dist_below[i-1])
    Moment += (mm-dist_below[-1])*find_shear(mm)
    return Moment

print(find_moment(1200))


'''
Finds the highest moment at one position of the train
'''
def Highest_moment(Xini,P):
    global Forces
    global leForces
    global leDistances
    Define_bridge(Xini,P)
    max_Mom = 0
    for i in range(1200):
        if find_moment(i) > max_Mom:
            max_Mom = find_moment(i)
    return max_Mom

