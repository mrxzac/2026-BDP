'''
Finds the max shear, which will always be equal in magnitude to one of the reaction forces
'''
max_shears = []
def find_max_shear():
    global Ay
    global By
    the_max = 0
    for i in range(344):
        Define_bridge(i,P)
        max_shears.append(max(Ay,By))
    for i in range(len(max_shears)):
        if max_shears[i] > the_max:
            the_max = max_shears[i]
    return the_max

